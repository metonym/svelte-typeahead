{
  "name": "svelte-typeahead",
  "version": "5.0.2",
  "license": "MIT",
  "description": "Accessible, fuzzy search typeahead component",
  "author": "Eric Liu (https://github.com/metonym)",
  "type": "module",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./*.svelte": {
      "types": "./src/*.svelte.d.ts",
      "import": "./src/*.svelte"
    },
    "./*.js": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js"
    },
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "svelte": "./src/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:types": "svelte-check --workspace tests",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "fuzzy": "0.1.3",
    "svelte-search": "^2.1.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "^1.3.3",
    "culls": "^0.1.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-readme": "^4.5.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-typeahead.git"
  },
  "homepage": "https://github.com/metonym/svelte-typeahead",
  "bugs": "https://github.com/metonym/svelte-typeahead/issues",
  "keywords": [
    "svelte",
    "svelte component",
    "typeahead",
    "fuzzy",
    "highlight",
    "search",
    "filter",
    "WAI-ARIA",
    "accessibility"
  ],
  "files": [
    "src"
  ]
}
